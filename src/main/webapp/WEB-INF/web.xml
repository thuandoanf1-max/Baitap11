<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>BookStore 24162124 - De 02</display-name>

    <filter>
        <filter-name>EncodingFilter_24162124</filter-name>
        <filter-class>vn.edu.hcmute.exam02.filter.EncodingFilter_24162124</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter_24162124</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AdminAuthorizationFilter_24162124</filter-name>
        <filter-class>vn.edu.hcmute.exam02.filter.AdminAuthorizationFilter_24162124</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminAuthorizationFilter_24162124</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>sitemesh</filter-name>
        <filter-class>org.sitemesh.config.ConfigurableSiteMeshFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>sitemesh</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <servlet>
        <servlet-name>HomeController_24162124</servlet-name>
        <servlet-class>vn.edu.hcmute.exam02.controller.HomeController_24162124</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeController_24162124</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProductController_24162124</servlet-name>
        <servlet-class>vn.edu.hcmute.exam02.controller.ProductController_24162124</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductController_24162124</servlet-name>
        <url-pattern>/products</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookDetailController_24162124</servlet-name>
        <servlet-class>vn.edu.hcmute.exam02.controller.BookDetailController_24162124</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookDetailController_24162124</servlet-name>
        <url-pattern>/book/detail</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterController_24162124</servlet-name>
        <servlet-class>vn.edu.hcmute.exam02.controller.RegisterController_24162124</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterController_24162124</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VerifyOtpController_24162124</servlet-name>
        <servlet-class>vn.edu.hcmute.exam02.controller.VerifyOtpController_24162124</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VerifyOtpController_24162124</servlet-name>
        <url-pattern>/verify-otp</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginController_24162124</servlet-name>
        <servlet-class>vn.edu.hcmute.exam02.controller.LoginController_24162124</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginController_24162124</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutController_24162124</servlet-name>
        <servlet-class>vn.edu.hcmute.exam02.controller.LogoutController_24162124</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutController_24162124</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminController_24162124</servlet-name>
        <servlet-class>vn.edu.hcmute.exam02.controller.AdminController_24162124</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminController_24162124</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookAdminController_24162124</servlet-name>
        <servlet-class>vn.edu.hcmute.exam02.controller.BookAdminController_24162124</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookAdminController_24162124</servlet-name>
        <url-pattern>/admin/books</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CartController_24162124</servlet-name>
        <servlet-class>vn.edu.hcmute.exam02.controller.CartController_24162124</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CartController_24162124</servlet-name>
        <url-pattern>/cart</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CheckoutController_24162124</servlet-name>
        <servlet-class>vn.edu.hcmute.exam02.controller.CheckoutController_24162124</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckoutController_24162124</servlet-name>
        <url-pattern>/checkout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OrderHistoryController_24162124</servlet-name>
        <servlet-class>vn.edu.hcmute.exam02.controller.OrderHistoryController_24162124</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderHistoryController_24162124</servlet-name>
        <url-pattern>/orders</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>
</web-app>
